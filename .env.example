# KnowHow.ph — environment variables
# Copy to .env for local dev.

# Server-only. Required for the AI Career Guidance Quiz to return live Gemini analysis.
# Without it, the quiz endpoint returns a clear error and the UI shows a friendly fallback message.
GEMINI_API_KEY=

# Defaults to gemini-2.5-flash if unset.
GEMINI_MODEL=gemini-2.5-flash

# Port the Express server binds to (0.0.0.0).
PORT=3000
