# ---------------------------------------------------------------------------
# KnowHow PH — environment variables
# Copy to .env.local for local dev (Next.js loads .env.local automatically).
# ---------------------------------------------------------------------------

# --- Database (required) ----------------------------------------------------
# Supabase Postgres connection string used by Prisma at runtime (pooled, e.g. pgbouncer:6543).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/knowhow"
# Direct (non-pooled) connection, used by Prisma Migrate. On Supabase this is the
# port-5432 "direct connection" string; for local Postgres it can equal DATABASE_URL.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/knowhow"

# --- Supabase (required for auth; optional for local-only dev) -------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the client. Used for admin/service operations.
SUPABASE_SERVICE_ROLE_KEY=

# Comma-separated emails auto-promoted to the ADMIN role on first sign-in (MVP bootstrap only).
ADMIN_EMAILS=

# Comma-separated emails auto-provisioned as a SUPERVISOR in the EOD call log
# on first sign-in, if no ops agent exists for them yet (MVP bootstrap only —
# invite everyone else from /call-log/staff once one supervisor is in).
OPS_SUPERVISOR_EMAILS=

# --- Gemini AI enrichment (optional — app works fully without it) ----------
# Server-only. Never expose to the client.
GEMINI_API_KEY=
# Defaults to gemini-2.0-flash if unset.
GEMINI_MODEL=gemini-2.0-flash

# --- App (required) ----------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Analytics (optional — no-ops if absent) --------------------------------
POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# --- Rate limiting (optional — falls back to an in-memory limiter if absent) -
# "upstash" enables Redis-backed rate limiting across serverless instances.
RATE_LIMIT_PROVIDER=
RATE_LIMIT_REDIS_URL=
RATE_LIMIT_REDIS_TOKEN=
