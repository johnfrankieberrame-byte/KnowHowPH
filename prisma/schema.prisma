// KnowHow PH — Prisma schema
// PostgreSQL (Supabase). See docs/METHODOLOGY.md for provenance/verification model.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  USER
  ADMIN
}

enum PublicationStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum VerificationStatus {
  POC_SEED
  UNVERIFIED
  VERIFIED
  NEEDS_REVIEW
  ARCHIVED
}

enum SourceType {
  GOVERNMENT
  SCHOOL
  EMPLOYER
  JOB_PLATFORM
  PROFESSIONAL_BODY
  RESEARCH
  INTERNAL_POC
  OTHER
}

enum EducationLevel {
  HIGH_SCHOOL
  TESDA_CERTIFICATE
  ASSOCIATE_OR_DIPLOMA
  BACHELORS
  POSTGRADUATE
  LICENSE_REQUIRED
  VARIES
}

enum PathwayType {
  DEGREE
  TESDA
  CERTIFICATION
  BOOTCAMP
  SELF_STUDY
  APPRENTICESHIP
  PORTFOLIO
  LICENSURE
}

enum RatingLevel {
  VERY_LOW
  LOW
  MODERATE
  HIGH
  VERY_HIGH
}

enum EntryDifficulty {
  EASY
  MODERATE
  HARD
  VERY_HARD
}

enum SalaryDataStatus {
  POC_ESTIMATE
  VERIFIED
  NEEDS_REVIEW
}

enum MetricType {
  SALARY
  DEMAND
  SATURATION
  REMOTE_VIABILITY
  FREELANCE_VIABILITY
}

enum SkillCategory {
  TECHNICAL
  HUMAN
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum SchoolType {
  PUBLIC
  PRIVATE
  STATE_UNIVERSITY_COLLEGE
  TRAINING_PROVIDER
  ONLINE_PROVIDER
}

enum CredentialType {
  DEGREE
  DIPLOMA
  CERTIFICATE
  TESDA_ALIGNED
  BOOTCAMP
  SHORT_COURSE
}

enum DeliveryMode {
  IN_PERSON
  ONLINE
  HYBRID
}

enum QuizSectionKey {
  PERSONALITY_MOTIVATION
  SKILLS_STRENGTHS
  WORK_STYLE_FLEXIBILITY
  SALARY_GOALS
  EDUCATION_READINESS
  RISK_AMBITION
}

enum QuizQuestionType {
  LIKERT_5
  SINGLE_SELECT
  MULTI_SELECT
  SKILL_RATING
  SCENARIO
}

enum QuizAttemptStatus {
  IN_PROGRESS
  SUBMITTED
  ABANDONED
}

enum AiGenerationStatus {
  PENDING
  SUCCEEDED
  FAILED
  BLOCKED
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

/// Mirrors a Supabase Auth user (id == auth.users.id). Created on first login.
model User {
  id        String   @id @default(uuid())
  email     String   @unique
  role      Role     @default(USER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile      Profile?
  savedCareers SavedCareer[]
  quizAttempts QuizAttempt[]
  quizResults  QuizResult[]
  auditLogs    AdminAuditLog[]

  @@index([role])
}

model Profile {
  id             String          @id @default(cuid())
  userId         String          @unique
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName    String?
  avatarUrl      String?
  region         String?
  provinceCity   String?
  educationLevel EducationLevel?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

// ---------------------------------------------------------------------------
// Career taxonomy
// ---------------------------------------------------------------------------

model Industry {
  id                String            @id @default(cuid())
  slug              String            @unique
  name              String
  description       String
  icon              String?
  order             Int               @default(0)
  publicationStatus PublicationStatus @default(PUBLISHED)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  categories     CareerCategory[]
  primaryCareers Career[]         @relation("CareerPrimaryIndustry")

  @@index([publicationStatus])
}

model CareerCategory {
  id                String            @id @default(cuid())
  slug              String            @unique
  name              String
  description       String
  industryId        String
  industry          Industry          @relation(fields: [industryId], references: [id], onDelete: Cascade)
  order             Int               @default(0)
  publicationStatus PublicationStatus @default(PUBLISHED)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  primaryCareers    Career[] @relation("CareerPrimaryCategory")
  secondaryOfCareer Career[] @relation("CareerSecondaryCategories")

  @@index([industryId])
  @@index([publicationStatus])
}

model Career {
  id               String @id @default(cuid())
  slug             String @unique
  title            String
  shortDescription String
  longDescription  String

  primaryIndustryId   String
  primaryIndustry     Industry         @relation("CareerPrimaryIndustry", fields: [primaryIndustryId], references: [id])
  primaryCategoryId   String
  primaryCategory     CareerCategory   @relation("CareerPrimaryCategory", fields: [primaryCategoryId], references: [id])
  secondaryCategories CareerCategory[] @relation("CareerSecondaryCategories")

  aliases CareerAlias[]

  responsibilities String[]
  goodFitIf        String[]
  challengingIf    String[]

  workEnvironment  String
  workStyleSummary String?

  educationLevel       EducationLevel
  entryDifficulty      EntryDifficulty
  timeToEntryMinMonths Int
  timeToEntryMaxMonths Int
  remoteViability      RatingLevel
  freelanceViability   RatingLevel

  entryLevelTitle  String?
  midLevelTitle    String?
  seniorLevelTitle String?

  relatedCareers   Career[] @relation("CareerRelated")
  relatedOfCareers Career[] @relation("CareerRelated")

  skills          CareerSkill[]
  workStyleTags   CareerWorkStyleTag[]
  pathways        CareerPathway[]
  certifications  CareerCertification[]
  metrics         CareerMetric[]
  sourceRefs      CareerSourceReference[]
  savedBy         SavedCareer[]
  programLinks    ProgramCareer[]
  quizProfile     CareerQuizProfile?
  quizResultLinks QuizResultCareer[]

  seoTitle       String?
  seoDescription String?

  publicationStatus  PublicationStatus  @default(DRAFT)
  verificationStatus VerificationStatus @default(POC_SEED)
  lastReviewedAt     DateTime?
  nextReviewDueAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([primaryIndustryId])
  @@index([primaryCategoryId])
  @@index([publicationStatus])
  @@index([verificationStatus])
  @@index([educationLevel])
  @@index([entryDifficulty])
  @@index([remoteViability])
  @@index([freelanceViability])
}

model CareerAlias {
  id       String @id @default(cuid())
  careerId String
  career   Career @relation(fields: [careerId], references: [id], onDelete: Cascade)
  alias    String

  @@unique([careerId, alias])
  @@index([alias])
}

model Skill {
  id          String        @id @default(cuid())
  slug        String        @unique
  name        String
  category    SkillCategory
  description String?
  createdAt   DateTime      @default(now())

  careers CareerSkill[]

  @@index([category])
}

model CareerSkill {
  id          String     @id @default(cuid())
  careerId    String
  career      Career     @relation(fields: [careerId], references: [id], onDelete: Cascade)
  skillId     String
  skill       Skill      @relation(fields: [skillId], references: [id], onDelete: Cascade)
  proficiency SkillLevel @default(BEGINNER)
  isCore      Boolean    @default(true)

  @@unique([careerId, skillId])
  @@index([skillId])
}

model WorkStyleTag {
  id   String @id @default(cuid())
  slug String @unique
  name String

  careers CareerWorkStyleTag[]
}

model CareerWorkStyleTag {
  id       String       @id @default(cuid())
  careerId String
  career   Career       @relation(fields: [careerId], references: [id], onDelete: Cascade)
  tagId    String
  tag      WorkStyleTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([careerId, tagId])
  @@index([tagId])
}

model CareerPathway {
  id                    String      @id @default(cuid())
  careerId              String
  career                Career      @relation(fields: [careerId], references: [id], onDelete: Cascade)
  type                  PathwayType
  title                 String
  description           String
  typicalDurationMonths Int?
  isRequired            Boolean     @default(false)
  order                 Int         @default(0)

  @@index([careerId])
}

model Certification {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  issuingBody String
  description String?
  isLicensure Boolean @default(false)

  careers CareerCertification[]
}

model CareerCertification {
  id              String        @id @default(cuid())
  careerId        String
  career          Career        @relation(fields: [careerId], references: [id], onDelete: Cascade)
  certificationId String
  certification   Certification @relation(fields: [certificationId], references: [id], onDelete: Cascade)
  isRequired      Boolean       @default(false)
  notes           String?

  @@unique([careerId, certificationId])
  @@index([certificationId])
}

// ---------------------------------------------------------------------------
// Metrics & provenance
// ---------------------------------------------------------------------------

model DataSource {
  id                 String             @id @default(cuid())
  title              String
  publisher          String
  url                String?
  sourceType         SourceType
  sourceDate         DateTime?
  retrievedDate      DateTime?
  methodologySummary String?
  verificationStatus VerificationStatus @default(UNVERIFIED)
  notes              String?
  archivedUrl        String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  careerMetrics    CareerMetric[]
  careerReferences CareerSourceReference[]
  schoolPrograms   SchoolProgram[]

  @@index([sourceType])
  @@index([verificationStatus])
}

model CareerMetric {
  id              String           @id @default(cuid())
  careerId        String
  career          Career           @relation(fields: [careerId], references: [id], onDelete: Cascade)
  metricType      MetricType
  salaryMin       Int?
  salaryMax       Int?
  currency        String           @default("PHP")
  rating          RatingLevel?
  geography       String           @default("Philippines")
  experienceLevel String?
  periodLabel     String?
  methodologyNote String?
  status          SalaryDataStatus @default(POC_ESTIMATE)
  effectiveDate   DateTime?
  sourceId        String?
  source          DataSource?      @relation(fields: [sourceId], references: [id])
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([careerId, metricType])
  @@index([sourceId])
}

model CareerSourceReference {
  id           String     @id @default(cuid())
  careerId     String
  career       Career     @relation(fields: [careerId], references: [id], onDelete: Cascade)
  sourceId     String
  source       DataSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  fieldContext String
  note         String?
  createdAt    DateTime   @default(now())

  @@index([careerId])
  @@index([sourceId])
}

// ---------------------------------------------------------------------------
// Schools & programs
// ---------------------------------------------------------------------------

model School {
  id                 String             @id @default(cuid())
  slug               String             @unique
  name               String
  type               SchoolType
  region             String
  provinceCity       String
  website            String?
  description        String
  accreditationNote  String?
  verificationStatus VerificationStatus @default(POC_SEED)
  publicationStatus  PublicationStatus  @default(PUBLISHED)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  schoolPrograms SchoolProgram[]

  @@index([region])
  @@index([type])
  @@index([verificationStatus])
}

model Program {
  id                 String             @id @default(cuid())
  slug               String             @unique
  name               String
  credentialType     CredentialType
  durationLabel      String
  deliveryMode       DeliveryMode
  admissionNotes     String?
  tuitionNote        String?
  verificationStatus VerificationStatus @default(POC_SEED)
  publicationStatus  PublicationStatus  @default(PUBLISHED)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  schoolPrograms SchoolProgram[]
  programCareers ProgramCareer[]

  @@index([credentialType])
  @@index([deliveryMode])
  @@index([verificationStatus])
}

model SchoolProgram {
  id                  String      @id @default(cuid())
  schoolId            String
  school              School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  programId           String
  program             Program     @relation(fields: [programId], references: [id], onDelete: Cascade)
  tuitionNoteOverride String?
  notes               String?
  sourceId            String?
  source              DataSource? @relation(fields: [sourceId], references: [id])
  createdAt           DateTime    @default(now())

  @@unique([schoolId, programId])
  @@index([programId])
}

model ProgramCareer {
  id            String  @id @default(cuid())
  programId     String
  program       Program @relation(fields: [programId], references: [id], onDelete: Cascade)
  careerId      String
  career        Career  @relation(fields: [careerId], references: [id], onDelete: Cascade)
  relevanceNote String?

  @@unique([programId, careerId])
  @@index([careerId])
}

// ---------------------------------------------------------------------------
// User saved data
// ---------------------------------------------------------------------------

model SavedCareer {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  careerId  String
  career    Career   @relation(fields: [careerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, careerId])
  @@index([careerId])
}

// ---------------------------------------------------------------------------
// Quiz engine
// ---------------------------------------------------------------------------

model Quiz {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String
  version     Int      @default(1)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  sections QuizSection[]
  attempts QuizAttempt[]

  @@index([isActive])
}

model QuizSection {
  id          String         @id @default(cuid())
  quizId      String
  quiz        Quiz           @relation(fields: [quizId], references: [id], onDelete: Cascade)
  key         QuizSectionKey
  title       String
  description String
  weight      Float
  order       Int            @default(0)

  questions QuizQuestion[]

  @@unique([quizId, key])
  @@index([quizId])
}

model QuizQuestion {
  id         String           @id @default(cuid())
  sectionId  String
  section    QuizSection      @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  type       QuizQuestionType
  prompt     String
  helpText   String?
  order      Int              @default(0)
  isRequired Boolean          @default(true)

  options QuizOption[]
  answers QuizAnswer[]

  @@index([sectionId])
}

/// traitWeights: Record<TraitKey, number 0-100> contribution when this option is selected
/// (for LIKERT_5, one option row per scale point 1-5)
model QuizOption {
  id           String       @id @default(cuid())
  questionId   String
  question     QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  label        String
  value        String
  order        Int          @default(0)
  traitWeights Json

  @@index([questionId])
}

/// Deterministic trait-vector profile per career used by the scoring engine.
model CareerQuizProfile {
  id                 String   @id @default(cuid())
  careerId           String   @unique
  career             Career   @relation(fields: [careerId], references: [id], onDelete: Cascade)
  idealTraits        Json
  acceptableRanges   Json
  traitWeights       Json
  hardConstraints    Json?
  boosts             Json?
  calculationVersion Int      @default(1)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model QuizAttempt {
  id          String            @id @default(cuid())
  quizId      String
  quiz        Quiz              @relation(fields: [quizId], references: [id])
  userId      String?
  user        User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  anonymousId String?
  status      QuizAttemptStatus @default(IN_PROGRESS)
  currentStep Int               @default(0)
  startedAt   DateTime          @default(now())
  submittedAt DateTime?

  answers QuizAnswer[]
  result  QuizResult?

  @@index([userId])
  @@index([anonymousId])
  @@index([status])
}

model QuizAnswer {
  id         String       @id @default(cuid())
  attemptId  String
  attempt    QuizAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId String
  question   QuizQuestion @relation(fields: [questionId], references: [id])
  valueJson  Json
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@unique([attemptId, questionId])
  @@index([questionId])
}

/// resultToken is the opaque, unguessable identifier used in public result URLs.
model QuizResult {
  id                 String      @id @default(cuid())
  attemptId          String      @unique
  attempt            QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  resultToken        String      @unique
  userId             String?
  user               User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  traitScores        Json
  sectionScores      Json
  calculationVersion Int
  createdAt          DateTime    @default(now())
  expiresAt          DateTime?

  careers       QuizResultCareer[]
  aiGenerations AiGeneration[]

  @@index([userId])
  @@index([resultToken])
}

model QuizResultCareer {
  id             String     @id @default(cuid())
  quizResultId   String
  quizResult     QuizResult @relation(fields: [quizResultId], references: [id], onDelete: Cascade)
  careerId       String
  career         Career     @relation(fields: [careerId], references: [id])
  rank           Int
  rawScore       Float
  adjustedScore  Float
  scoreBreakdown Json
  matchReasons   String[]
  tradeOffs      String[]
  createdAt      DateTime   @default(now())

  @@unique([quizResultId, careerId])
  @@index([careerId])
}

model AiGeneration {
  id                    String             @id @default(cuid())
  quizResultId          String
  quizResult            QuizResult         @relation(fields: [quizResultId], references: [id], onDelete: Cascade)
  status                AiGenerationStatus @default(PENDING)
  model                 String?
  promptVersion         String?
  requestPayloadSummary Json?
  responseJson          Json?
  errorMessage          String?
  latencyMs             Int?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  @@index([quizResultId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Admin
// ---------------------------------------------------------------------------

model AdminAuditLog {
  id          String   @id @default(cuid())
  actorUserId String
  actor       User     @relation(fields: [actorUserId], references: [id])
  action      String
  entityType  String
  entityId    String
  changesJson Json?
  createdAt   DateTime @default(now())

  @@index([actorUserId])
  @@index([entityType, entityId])
  @@index([createdAt])
}
